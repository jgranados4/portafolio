---
import Tags from "./Tags.astro";

interface Props {
  title: string;
  description: string;
  tags: string[];
  link: string;
}
const { title, description, tags, link } = Astro.props;
---

<article
  class="border border-slate-200 dark:border-slate-800 p-6 rounded-2xl hover:shadow-lg bg-white dark:bg-slate-800/50 flex flex-col h-full
  transition-all duration-300 hover:-translate-y-2  hover:border-blue-500/30"
>
  <h3 class="text-xl font-bold mb-2">{title}</h3>
  <p class="text-slate-600 dark:text-slate-400 mb-6 text-sm">
    {description}
  </p>
  <div class="flex flex-wrap gap-2 mb-6">
    {tags.map((tag) => <Tags name={tag} />)}
  </div>
  <a
    href={link}
    target="_blank"
    rel="noopener noreferrer"
    class="text-blue-600 dark:text-blue-400 font-medium hover:underline inline-flex items-center gap-1 text-sm mt-auto"
  >
    Ver código en GitHub &rarr;
  </a>
</article>
