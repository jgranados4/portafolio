---
import Tags from "./Tags.astro";
interface Props {
  title: string;
  skills: string[];
}
const { title, skills } = Astro.props;
---

<div class="mb-8">
  <h3 class="text-lg font-bold mb-4 text-slate-800 dark:text-slate-200">
    {title}
  </h3>
  <div class="flex flex-wrap gap-2 ">
    {skills.map((skill) => <Tags name={skill} />)}
  </div>
</div>
